PUBLIC_BASE_PATH=/amisostock
PUBLIC_URL=https://fxrkqn.org/amisostock
API_PORT=3011
WEB_PORT=3010

DATABASE_URL=postgresql://amisostock:password@localhost:5432/amisostock
REDIS_URL=redis://localhost:6379/1

# Yer tutucuları yerel, rastgele üretilmiş sırlarla değiştirin.
JWT_SECRET=<32+ karakter rastgele>
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
SETUP_TOKEN=<ilk admin için tek kullanımlık>

RESEND_API_KEY=
EMAIL_FROM=noreply@fxrkqn.org
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

SERVER_MODE=private

PROVIDER_EQUITY_PRIMARY=
PROVIDER_EQUITY_FALLBACK=
PROVIDER_CRYPTO=binance
# CoinGecko Demo'yu yalnız kullanım şartları, görünür atıf ve ürün gizlilik/kullanım belgeleri hazırsa etkinleştirin.
PROVIDER_CRYPTO_FALLBACK=
COINGECKO_API_KEY=
EVDS_API_KEY=
KAP_API_KEY=
NEWS_FEEDS_FILE=./config/news-feeds.json

# Bulut sağlayıcısı kullanılıyorsa AI_API_KEY boş bırakılamaz.
AI_PROVIDER=google
AI_API_KEY=
AI_DAILY_REQUEST_CAP=200
AI_MONTHLY_BUDGET_USD=0

SENTRY_DSN=
LOG_LEVEL=info
