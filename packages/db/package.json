{
  "name": "@amisostock/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "import": "./dist/client.js"
    }
  },
  "scripts": {
    "typecheck": "tsc --project tsconfig.json --noEmit",
    "build": "tsc --project tsconfig.json",
    "db:generate": "drizzle-kit generate --dialect postgresql --schema ./src/schema/index.ts --out ./migrations",
    "db:check": "drizzle-kit check --dialect postgresql --out ./migrations",
    "db:migrate": "node --env-file-if-exists=../../.env scripts/migrate.mjs",
    "db:integration": "node scripts/integration.mjs"
  },
  "dependencies": {
    "@amisostock/shared": "workspace:*",
    "drizzle-orm": "0.45.2",
    "pg": "8.23.0"
  },
  "devDependencies": {
    "@types/pg": "8.23.1",
    "drizzle-kit": "0.31.10"
  }
}
